// ========== STATE ==========
let state = {
  level: 'topik1',
  category: null,
  words: [],
  currentIndex: 0,
  known: [],
  unknown: [],
  mastered: new Set(JSON.parse(localStorage.getItem('topik_mastered') || '[]')),
  view: 'study', // study, quiz, wordlist
  quizScore: 0,
  quizTotal: 0,
  quizAnswered: false,
  wrongWords: []
};

// ========== INIT ==========
function init() {
  updateHeaderStats();
  updateLevelCounts();
  renderCategories();
}

function updateHeaderStats() {
  document.getElementById('headerMastered').textContent = state.mastered.size;
  let total = 0;
  Object.values(VOCABULARY).forEach(lv => Object.values(lv).forEach(cat => total += cat.length));
  document.getElementById('headerTotal').textContent = total;
}

function updateLevelCounts() {
  ['topik1', 'topik2'].forEach(lv => {
    let count = 0;
    Object.values(VOCABULARY[lv]).forEach(cat => count += cat.length);
    document.getElementById('count' + lv.charAt(0).toUpperCase() + lv.slice(1)).textContent = count + ' 词';
  });
}

// ========== SELECTION ==========
function selectLevel(level) {
  state.level = level;
  state.category = null;
  document.querySelectorAll('.level-card').forEach(c => c.classList.remove('selected'));
  document.querySelector(`[data-level="${level}"]`).classList.add('selected');
  renderCategories();
}

function renderCategories() {
  const list = document.getElementById('categoryList');
  const cats = Object.keys(VOCABULARY[state.level]);
  list.innerHTML = cats.map(cat => {
    const count = VOCABULARY[state.level][cat].length;
    return `<div class="category-chip${state.category === cat ? ' selected' : ''}" onclick="selectCategory('${cat}')">
      ${cat}<span class="chip-count">${count} 词</span>
    </div>`;
  }).join('');
}

function selectCategory(cat) {
  state.category = cat;
  renderCategories();
}

// ========== STUDY MODE ==========
function startStudy() {
  if (!state.category) {
    state.words = [];
    Object.values(VOCABULARY[state.level]).forEach(cat => state.words.push(...cat));
  } else {
    state.words = [...VOCABULARY[state.level][state.category]];
  }
  if (state.words.length === 0) return;

  shuffleArray(state.words);
  state.currentIndex = 0;
  state.known = [];
  state.unknown = [];
  state.wrongWords = [];

  showView('studyView');
  renderCard();
}

function renderCard() {
  const word = state.words[state.currentIndex];
  const total = state.words.length;
  const idx = state.currentIndex + 1;

  document.getElementById('studyProgress').style.width = (idx / total * 100) + '%';
  document.getElementById('studyCount').textContent = `${idx} / ${total}`;
  document.getElementById('studyCategory').textContent = state.category || '全部';

  document.getElementById('cardWord').textContent = word.kr;
  document.getElementById('cardMeaning').textContent = word.cn;
  document.getElementById('cardExampleKr').textContent = word.ex_kr || '';
  document.getElementById('cardExampleCn').textContent = word.ex_cn || '';
  document.getElementById('cardTagFront').textContent = state.category || '';
  document.getElementById('cardTagBack').textContent = state.category || '';

  // Reset flip
  document.getElementById('flashcard').classList.remove('flipped');

  // Update master button
  const masterBtn = document.getElementById('masterBtn');
  if (state.mastered.has(word.kr)) {
    masterBtn.textContent = '已掌握 ✓';
    masterBtn.classList.add('mastered');
  } else {
    masterBtn.textContent = '标记已掌握';
    masterBtn.classList.remove('mastered');
  }
}

function flipCard() {
  document.getElementById('flashcard').classList.toggle('flipped');
}

function nextCard() {
  if (state.currentIndex < state.words.length - 1) {
    state.currentIndex++;
    renderCard();
  } else {
    showResult();
  }
}

function prevCard() {
  if (state.currentIndex > 0) {
    state.currentIndex--;
    renderCard();
  }
}

function markWord(known) {
  const word = state.words[state.currentIndex];
  if (known) {
    state.known.push(word);
  } else {
    state.unknown.push(word);
    state.wrongWords.push(word);
  }
  nextCard();
}

function toggleMastered() {
  const word = state.words[state.currentIndex];
  if (state.mastered.has(word.kr)) {
    state.mastered.delete(word.kr);
  } else {
    state.mastered.add(word.kr);
  }
  localStorage.setItem('topik_mastered', JSON.stringify([...state.mastered]));
  updateHeaderStats();
  renderCard();
}

// ========== QUIZ MODE ==========
function startQuiz(words) {
  const pool = words || (state.category
    ? [...VOCABULARY[state.level][state.category]]
    : Object.values(VOCABULARY[state.level]).flat());

  if (pool.length < 4) {
    alert('至少需要4个单词才能开始测验');
    return;
  }

  shuffleArray(pool);
  state.words = pool.slice(0, Math.min(10, pool.length));
  state.quizScore = 0;
  state.quizTotal = 0;
  state.currentIndex = 0;
  state.wrongWords = [];

  showView('quizView');
  renderQuiz();
}

function renderQuiz() {
  const word = state.words[state.currentIndex];
  const total = state.words.length;
  const idx = state.currentIndex + 1;

  document.getElementById('quizProgress').style.width = (idx / total * 100) + '%';
  document.getElementById('quizCount').textContent = `${idx} / ${total}`;
  document.getElementById('quizScore').textContent = `得分: ${state.quizScore}`;
  document.getElementById('quizWord').textContent = word.kr;

  // Generate options
  const allWords = state.category
    ? VOCABULARY[state.level][state.category]
    : Object.values(VOCABULARY[state.level]).flat();

  let options = [word.cn];
  const others = allWords.filter(w => w.cn !== word.cn).map(w => w.cn);
  shuffleArray(others);
  while (options.length < 4 && others.length > 0) {
    const opt = others.pop();
    if (!options.includes(opt)) options.push(opt);
  }
  shuffleArray(options);

  const container = document.getElementById('quizOptions');
  container.innerHTML = options.map(opt =>
    `<button class="quiz-option" onclick="answerQuiz(this, '${escapeStr(opt)}', '${escapeStr(word.cn)}')">${opt}</button>`
  ).join('');

  document.getElementById('quizResult').classList.add('hidden');
  document.getElementById('quizNextBtn').classList.add('hidden');
  state.quizAnswered = false;
}

function escapeStr(s) {
  return s.replace(/'/g, "\\'");
}

function answerQuiz(btn, selected, correct) {
  if (state.quizAnswered) return;
  state.quizAnswered = true;
  state.quizTotal++;

  const options = document.querySelectorAll('.quiz-option');
  options.forEach(opt => {
    opt.classList.add('disabled');
    if (opt.textContent === correct) opt.classList.add('correct');
  });

  const resultDiv = document.getElementById('quizResult');
  resultDiv.classList.remove('hidden');

  if (selected === correct) {
    state.quizScore++;
    resultDiv.className = 'quiz-result correct';
    resultDiv.textContent = '正确!';
  } else {
    btn.classList.add('wrong');
    resultDiv.className = 'quiz-result wrong';
    resultDiv.textContent = `错误! 正确答案: ${correct}`;
    state.wrongWords.push(state.words[state.currentIndex]);
  }

  document.getElementById('quizScore').textContent = `得分: ${state.quizScore}`;
  document.getElementById('quizNextBtn').classList.remove('hidden');
  document.getElementById('quizNextBtn').textContent =
    state.currentIndex < state.words.length - 1 ? '下一题' : '查看结果';
}

function nextQuiz() {
  if (state.currentIndex < state.words.length - 1) {
    state.currentIndex++;
    renderQuiz();
  } else {
    showResult();
  }
}

// ========== RESULT ==========
function showResult() {
  const correct = state.known.length || state.quizScore;
  const wrong = state.unknown.length || (state.quizTotal - state.quizScore);
  const total = correct + wrong;
  const percent = total > 0 ? Math.round(correct / total * 100) : 0;

  showView('resultView');

  document.getElementById('resultCorrect').textContent = correct;
  document.getElementById('resultWrong').textContent = wrong;
  document.getElementById('resultPercent').textContent = percent + '%';

  // Animate circle
  const circle = document.getElementById('resultCircle');
  const circumference = 264;
  const offset = circumference - (percent / 100) * circumference;
  setTimeout(() => { circle.style.strokeDashoffset = offset; }, 100);

  // Color based on score
  if (percent >= 80) {
    circle.style.stroke = 'var(--success)';
  } else if (percent >= 50) {
    circle.style.stroke = 'var(--warning)';
  } else {
    circle.style.stroke = 'var(--accent)';
  }
}

function reviewWrong() {
  if (state.wrongWords.length === 0) {
    alert('没有错词需要复习!');
    return;
  }
  state.words = [...state.wrongWords];
  state.currentIndex = 0;
  state.known = [];
  state.unknown = [];
  state.wrongWords = [];
  shuffleArray(state.words);

  showView('studyView');
  renderCard();
}

// ========== WORD LIST ==========
function renderWordList(filter) {
  const container = document.getElementById('wordListContainer');
  const allWords = [];

  Object.entries(VOCABULARY).forEach(([lv, cats]) => {
    Object.entries(cats).forEach(([cat, words]) => {
      words.forEach(w => {
        if (!filter || w.kr.includes(filter) || w.cn.includes(filter)) {
          allWords.push({ ...w, level: lv, category: cat });
        }
      });
    });
  });

  container.innerHTML = allWords.map(w => `
    <div class="word-item">
      <div class="word-item-left">
        <span class="word-item-kr">${w.kr}</span>
        <span class="word-item-cn">${w.cn}</span>
      </div>
      <div>
        <span class="word-item-tag${state.mastered.has(w.kr) ? ' mastered' : ''}">${w.category}</span>
      </div>
    </div>
  `).join('');
}

function filterWordList() {
  const q = document.getElementById('wordlistSearch').value.trim();
  renderWordList(q);
}

// ========== VIEW SWITCHING ==========
function switchView(view) {
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.querySelector(`[data-view="${view}"]`).classList.add('active');

  if (view === 'wordlist') {
    showView('wordlistView');
    renderWordList();
  } else if (view === 'quiz') {
    // Need to select level/category first, then start quiz
    showView('selectionView');
    document.getElementById('startBtn').textContent = '开始测验';
    document.getElementById('startBtn').onclick = () => startQuiz();
  } else {
    showView('selectionView');
    document.getElementById('startBtn').textContent = '开始学习';
    document.getElementById('startBtn').onclick = () => startStudy();
  }
}

function showView(viewId) {
  ['selectionView', 'studyView', 'quizView', 'resultView', 'wordlistView'].forEach(id => {
    document.getElementById(id).classList.add('hidden');
  });
  document.getElementById(viewId).classList.remove('hidden');
}

function backToSelection() {
  // Reset circle animation
  document.getElementById('resultCircle').style.strokeDashoffset = 264;

  const activeNav = document.querySelector('.nav-btn.active');
  const view = activeNav ? activeNav.dataset.view : 'study';

  if (view === 'quiz') {
    document.getElementById('startBtn').textContent = '开始测验';
    document.getElementById('startBtn').onclick = () => startQuiz();
  } else {
    document.getElementById('startBtn').textContent = '开始学习';
    document.getElementById('startBtn').onclick = () => startStudy();
  }

  showView('selectionView');
}

// ========== UTILS ==========
function shuffleArray(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

// ========== START ==========
init();
</script>

