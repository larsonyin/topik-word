<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TOPIK 单词背诵</title>
  <meta name="description" content="TOPIK韩国语能力考试词汇学习工具，帮助你高效背诵韩语单词">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #4A6CF7;
      --primary-light: #6B8AFF;
      --primary-dark: #3451B2;
      --accent: #FF6B6B;
      --accent-light: #FF8E8E;
      --success: #22C55E;
      --warning: #F59E0B;
      --bg: #F0F4FF;
      --bg-card: #FFFFFF;
      --text: #1E293B;
      --text-secondary: #64748B;
      --text-light: #94A3B8;
      --border: #E2E8F0;
      --shadow: 0 4px 24px rgba(74, 108, 247, 0.08);
      --shadow-lg: 0 8px 40px rgba(74, 108, 247, 0.12);
      --radius: 16px;
      --radius-sm: 10px;
      --radius-xs: 6px;
      --font-kr: 'Noto Sans KR', system-ui, sans-serif;
      --font-cn: 'Noto Sans SC', system-ui, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-cn);
      color: var(--text);
      background: var(--bg);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Header */
    .header {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      padding: 1rem 1.5rem;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 20px rgba(74, 108, 247, 0.2);
    }
    .header-inner {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-size: 1.25rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .logo-icon {
      width: 32px;
      height: 32px;
      background: rgba(255,255,255,0.2);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }
    .header-stats {
      display: flex;
      gap: 1rem;
      font-size: 0.85rem;
      opacity: 0.9;
    }
    .header-stat {
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    /* Navigation */
    .nav {
      max-width: 800px;
      margin: 1rem auto 0;
      padding: 0 1.5rem;
      display: flex;
      gap: 0.5rem;
    }
    .nav-btn {
      flex: 1;
      padding: 0.75rem 1rem;
      border: none;
      background: var(--bg-card);
      color: var(--text-secondary);
      font-family: var(--font-cn);
      font-size: 0.9rem;
      font-weight: 500;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: var(--shadow);
    }
    .nav-btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-lg); }
    .nav-btn.active {
      background: var(--primary);
      color: white;
    }

    /* Main */
    .main {
      max-width: 800px;
      margin: 1rem auto;
      padding: 0 1.5rem 3rem;
    }

    /* Level & Category Selection */
    .selection-view { animation: fadeIn 0.3s ease; }
    .section-title {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: var(--text);
    }
    .level-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .level-card {
      background: var(--bg-card);
      border: 2px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem;
      cursor: pointer;
      transition: all 0.2s;
      text-align: center;
    }
    .level-card:hover { border-color: var(--primary-light); transform: translateY(-2px); box-shadow: var(--shadow-lg); }
    .level-card.selected { border-color: var(--primary); background: #F0F4FF; }
    .level-card .level-name {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    .level-card .level-desc {
      font-size: 0.8rem;
      color: var(--text-secondary);
    }
    .level-card .level-count {
      font-size: 0.75rem;
      color: var(--primary);
      margin-top: 0.5rem;
      font-weight: 500;
    }

    .category-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .category-chip {
      background: var(--bg-card);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.6rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      text-align: center;
      color: var(--text);
      font-family: var(--font-cn);
    }
    .category-chip:hover { border-color: var(--primary-light); }
    .category-chip.selected { border-color: var(--primary); background: var(--primary); color: white; }
    .category-chip .chip-count {
      display: block;
      font-size: 0.7rem;
      color: var(--text-light);
      margin-top: 0.15rem;
    }
    .category-chip.selected .chip-count { color: rgba(255,255,255,0.8); }

    .start-btn {
      display: block;
      width: 100%;
      padding: 1rem;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      border: none;
      border-radius: var(--radius);
      font-size: 1.05rem;
      font-weight: 600;
      font-family: var(--font-cn);
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 16px rgba(74, 108, 247, 0.3);
    }
    .start-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(74, 108, 247, 0.4); }
    .start-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    /* Study View */
    .study-view { animation: fadeIn 0.3s ease; }
    .progress-bar-wrap {
      background: var(--border);
      border-radius: 99px;
      height: 6px;
      margin-bottom: 1rem;
      overflow: hidden;
    }
    .progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--primary-light));
      border-radius: 99px;
      transition: width 0.4s ease;
    }
    .progress-info {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }

    /* Flashcard */
    .flashcard-container {
      perspective: 1000px;
      margin: 0 auto 1.5rem;
      max-width: 420px;
    }
    .flashcard {
      width: 100%;
      min-height: 280px;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }
    .flashcard.flipped { transform: rotateY(180deg); }
    .flashcard-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      border-radius: var(--radius);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      box-shadow: var(--shadow-lg);
    }
    .flashcard-front {
      background: linear-gradient(145deg, #FFFFFF 0%, #F8FAFF 100%);
      border: 1px solid var(--border);
    }
    .flashcard-back {
      background: linear-gradient(145deg, var(--primary) 0%, var(--primary-light) 100%);
      color: white;
      transform: rotateY(180deg);
    }
    .card-word {
      font-family: var(--font-kr);
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .card-hint {
      font-size: 0.85rem;
      color: var(--text-light);
    }
    .flashcard-back .card-hint { color: rgba(255,255,255,0.7); }
    .card-meaning {
      font-size: 1.6rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }
    .card-example {
      font-size: 0.9rem;
      text-align: center;
      line-height: 1.6;
      opacity: 0.9;
    }
    .card-example-kr {
      font-family: var(--font-kr);
      margin-bottom: 0.25rem;
    }
    .card-example-cn {
      font-size: 0.85rem;
      opacity: 0.8;
    }
    .card-tag {
      position: absolute;
      top: 1rem;
      right: 1rem;
      font-size: 0.7rem;
      padding: 0.2rem 0.6rem;
      border-radius: 99px;
      background: rgba(0,0,0,0.05);
      color: var(--text-secondary);
    }
    .flashcard-back .card-tag { background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.8); }

    /* Card controls */
    .card-controls {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      margin-bottom: 1rem;
    }
    .ctrl-btn {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-weight: 500;
      font-family: var(--font-cn);
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .ctrl-btn:hover { transform: translateY(-1px); }
    .ctrl-btn.prev { background: var(--bg-card); color: var(--text-secondary); box-shadow: var(--shadow); }
    .ctrl-btn.next { background: var(--primary); color: white; box-shadow: 0 4px 12px rgba(74,108,247,0.25); }
    .ctrl-btn.know { background: var(--success); color: white; }
    .ctrl-btn.dunno { background: var(--accent); color: white; }

    .card-actions {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
    }
    .action-btn {
      padding: 0.5rem 1rem;
      border: 1.5px solid var(--border);
      background: var(--bg-card);
      color: var(--text-secondary);
      border-radius: var(--radius-xs);
      font-size: 0.8rem;
      font-family: var(--font-cn);
      cursor: pointer;
      transition: all 0.2s;
    }
    .action-btn:hover { border-color: var(--primary); color: var(--primary); }
    .action-btn.mastered { border-color: var(--success); color: var(--success); background: #F0FFF4; }

    /* Quiz View */
    .quiz-view { animation: fadeIn 0.3s ease; }
    .quiz-question {
      background: var(--bg-card);
      border-radius: var(--radius);
      padding: 2rem;
      text-align: center;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow);
    }
    .quiz-word {
      font-family: var(--font-kr);
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .quiz-prompt {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }
    .quiz-options {
      display: grid;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .quiz-option {
      background: var(--bg-card);
      border: 2px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 1rem 1.25rem;
      font-size: 1rem;
      font-family: var(--font-cn);
      cursor: pointer;
      transition: all 0.2s;
      text-align: left;
      color: var(--text);
    }
    .quiz-option:hover { border-color: var(--primary-light); background: #F8FAFF; }
    .quiz-option.correct { border-color: var(--success); background: #F0FFF4; color: var(--success); }
    .quiz-option.wrong { border-color: var(--accent); background: #FFF5F5; color: var(--accent); }
    .quiz-option.disabled { pointer-events: none; }

    .quiz-result {
      text-align: center;
      padding: 1rem;
      border-radius: var(--radius-sm);
      margin-bottom: 1rem;
      font-weight: 500;
      animation: fadeIn 0.3s ease;
    }
    .quiz-result.correct { background: #F0FFF4; color: var(--success); }
    .quiz-result.wrong { background: #FFF5F5; color: var(--accent); }

    .quiz-next-btn {
      display: block;
      width: 100%;
      padding: 0.9rem;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: var(--radius-sm);
      font-size: 1rem;
      font-weight: 500;
      font-family: var(--font-cn);
      cursor: pointer;
      transition: all 0.2s;
    }
    .quiz-next-btn:hover { background: var(--primary-dark); }

    /* Result View */
    .result-view {
      text-align: center;
      animation: fadeIn 0.3s ease;
    }
    .result-circle {
      width: 160px;
      height: 160px;
      margin: 1.5rem auto;
      position: relative;
    }
    .result-circle svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .result-circle .bg { fill: none; stroke: var(--border); stroke-width: 8; }
    .result-circle .fg { fill: none; stroke: var(--success); stroke-width: 8; stroke-linecap: round; transition: stroke-dashoffset 1s ease; }
    .result-score {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .result-score .num { font-size: 2.5rem; font-weight: 700; color: var(--primary); }
    .result-score .label { font-size: 0.85rem; color: var(--text-secondary); }
    .result-stats {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin: 1.5rem 0;
    }
    .result-stat { text-align: center; }
    .result-stat .val { font-size: 1.5rem; font-weight: 700; }
    .result-stat .lbl { font-size: 0.8rem; color: var(--text-secondary); }
    .result-stat.good .val { color: var(--success); }
    .result-stat.bad .val { color: var(--accent); }
    .result-actions {
      display: flex;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }
    .result-actions button { flex: 1; }

    /* Word List View */
    .wordlist-view { animation: fadeIn 0.3s ease; }
    .wordlist-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }
    .wordlist-search {
      padding: 0.5rem 1rem;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-xs);
      font-size: 0.9rem;
      font-family: var(--font-cn);
      width: 200px;
      transition: border-color 0.2s;
    }
    .wordlist-search:focus { outline: none; border-color: var(--primary); }
    .word-item {
      background: var(--bg-card);
      border-radius: var(--radius-sm);
      padding: 1rem 1.25rem;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 1px 4px rgba(0,0,0,0.04);
      transition: all 0.2s;
    }
    .word-item:hover { box-shadow: var(--shadow); }
    .word-item-left { display: flex; align-items: center; gap: 1rem; }
    .word-item-kr { font-family: var(--font-kr); font-size: 1.15rem; font-weight: 600; }
    .word-item-cn { font-size: 0.9rem; color: var(--text-secondary); }
    .word-item-tag {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
      border-radius: 99px;
      background: #F0F4FF;
      color: var(--primary);
    }
    .word-item-tag.mastered { background: #F0FFF4; color: var(--success); }

    /* Animations */
    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
    .shake { animation: shake 0.4s ease; }

    /* Responsive */
    @media (max-width: 480px) {
      .header { padding: 0.75rem 1rem; }
      .main { padding: 0 1rem 3rem; }
      .nav { padding: 0 1rem; }
      .card-word { font-size: 2rem; }
      .flashcard-face { padding: 1.5rem; }
      .level-grid { grid-template-columns: 1fr; }
      .category-list { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
      .header-stats { display: none; }
      .result-actions { flex-direction: column; }
    }

    /* Hidden utility */
    .hidden { display: none !important; }
  </style>
</head>
<body>

<header class="header">
  <div class="header-inner">
    <div class="logo">
      <div class="logo-icon">한</div>
      <span>TOPIK 单词背诵</span>
    </div>
    <div class="header-stats">
      <div class="header-stat">
        <span>已掌握</span>
        <strong id="headerMastered">0</strong>
      </div>
      <div class="header-stat">
        <span>总词数</span>
        <strong id="headerTotal">0</strong>
      </div>
    </div>
  </div>
</header>

<nav class="nav">
  <button class="nav-btn active" data-view="study" onclick="switchView('study')">学习</button>
  <button class="nav-btn" data-view="quiz" onclick="switchView('quiz')">测验</button>
  <button class="nav-btn" data-view="wordlist" onclick="switchView('wordlist')">词表</button>
</nav>

<main class="main">

  <!-- Selection View -->
  <div id="selectionView" class="selection-view">
    <h2 class="section-title">选择等级</h2>
    <div class="level-grid">
      <div class="level-card selected" data-level="topik1" onclick="selectLevel('topik1')">
        <div class="level-name">TOPIK I</div>
        <div class="level-desc">初级 · 초급</div>
        <div class="level-count" id="countTopik1">0 词</div>
      </div>
      <div class="level-card" data-level="topik2" onclick="selectLevel('topik2')">
        <div class="level-name">TOPIK II</div>
        <div class="level-desc">中高级 · 중고급</div>
        <div class="level-count" id="countTopik2">0 词</div>
      </div>
    </div>

    <h2 class="section-title">选择分类</h2>
    <div class="category-list" id="categoryList"></div>

    <button class="start-btn" id="startBtn" onclick="startStudy()">开始学习</button>
  </div>

  <!-- Study View -->
  <div id="studyView" class="study-view hidden">
    <div class="progress-bar-wrap">
      <div class="progress-bar" id="studyProgress" style="width: 0%"></div>
    </div>
    <div class="progress-info">
      <span id="studyCount">1 / 10</span>
      <span id="studyCategory"></span>
    </div>

    <div class="flashcard-container">
      <div class="flashcard" id="flashcard" onclick="flipCard()">
        <div class="flashcard-face flashcard-front">
          <span class="card-tag" id="cardTagFront"></span>
          <div class="card-word" id="cardWord"></div>
          <div class="card-hint">点击翻转查看释义</div>
        </div>
        <div class="flashcard-face flashcard-back">
          <span class="card-tag" id="cardTagBack"></span>
          <div class="card-meaning" id="cardMeaning"></div>
          <div class="card-example">
            <div class="card-example-kr" id="cardExampleKr"></div>
            <div class="card-example-cn" id="cardExampleCn"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card-controls">
      <button class="ctrl-btn prev" onclick="prevCard()">← 上一个</button>
      <button class="ctrl-btn dunno" onclick="markWord(false)">不认识</button>
      <button class="ctrl-btn know" onclick="markWord(true)">认识</button>
      <button class="ctrl-btn next" onclick="nextCard()">下一个 →</button>
    </div>

    <div class="card-actions">
      <button class="action-btn" id="masterBtn" onclick="toggleMastered()">标记已掌握</button>
      <button class="action-btn" onclick="backToSelection()">返回选择</button>
    </div>
  </div>

  <!-- Quiz View -->
  <div id="quizView" class="quiz-view hidden">
    <div class="progress-bar-wrap">
      <div class="progress-bar" id="quizProgress" style="width: 0%"></div>
    </div>
    <div class="progress-info">
      <span id="quizCount">1 / 10</span>
      <span id="quizScore">得分: 0</span>
    </div>

    <div class="quiz-question">
      <div class="quiz-word" id="quizWord"></div>
      <div class="quiz-prompt">选择正确的中文释义</div>
    </div>

    <div class="quiz-options" id="quizOptions"></div>
    <div id="quizResult" class="hidden"></div>
    <button class="quiz-next-btn hidden" id="quizNextBtn" onclick="nextQuiz()">下一题</button>
  </div>

  <!-- Result View -->
  <div id="resultView" class="result-view hidden">
    <h2>学习完成!</h2>
    <div class="result-circle">
      <svg viewBox="0 0 100 100">
        <circle class="bg" cx="50" cy="50" r="42"/>
        <circle class="fg" id="resultCircle" cx="50" cy="50" r="42" stroke-dasharray="264" stroke-dashoffset="264"/>
      </svg>
      <div class="result-score">
        <div class="num" id="resultPercent">0%</div>
        <div class="label">正确率</div>
      </div>
    </div>
    <div class="result-stats">
      <div class="result-stat good">
        <div class="val" id="resultCorrect">0</div>
        <div class="lbl">认识</div>
      </div>
      <div class="result-stat bad">
        <div class="val" id="resultWrong">0</div>
        <div class="lbl">不认识</div>
      </div>
    </div>
    <div class="result-actions">
      <button class="ctrl-btn prev" onclick="backToSelection()">重新选择</button>
      <button class="ctrl-btn next" onclick="reviewWrong()">复习错词</button>
    </div>
  </div>

  <!-- Word List View -->
  <div id="wordlistView" class="wordlist-view hidden">
    <div class="wordlist-header">
      <h2 class="section-title" style="margin-bottom:0">全部词汇</h2>
      <input type="text" class="wordlist-search" id="wordlistSearch" placeholder="搜索单词..." oninput="filterWordList()">
    </div>
    <div id="wordListContainer"></div>
  </div>

</main>

<script>
// ========== VOCABULARY DATA ==========
const VOCABULARY = {
